{
  "cleanupPeriodDays": 365,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Agent(codex:codex-rescue)",
      "Bash(PYTHONPATH=. uv run basedpyright:*)",
      "Bash(PYTHONPATH=. uv run pytest:*)",
      "Bash(PYTHONPATH=. uv run python -m pytest:*)",
      "Bash(PYTHONPATH=. uv run python main.py:*)",
      "Bash(PYTHONPATH=. uv run ruff:*)",
      "Bash(awk:*)",
      "Bash(basedpyright:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(node ~/.claude/plugins/cache/openai-codex/codex/*/scripts/codex-companion.mjs:*)",
      "Bash(pyright:*)",
      "Bash(rg:*)",
      "Bash(ruff:*)",
      "Bash(sed:*)",
      "Bash(tail:*)",
      "Bash(uv run basedpyright:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python -m pytest:*)",
      "Bash(uv run ruff:*)",
      "Skill(codex:rescue)",
      "Skill(codex:setup)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(rm --recursive --force:*)",
      "Bash(rm --force --recursive:*)",
      "Bash(sudo rm:*)",
      "Bash(mv:*)",
      "Bash(sudo mv:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -df:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git checkout .:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(git rebase -i:*)",
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --prune:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git filter-branch:*)",
      "Bash(git reflog expire:*)",
      "Bash(rm -r:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shred:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(systemctl halt:*)",
      "Bash(systemctl poweroff:*)",
      "Bash(systemctl reboot:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws configure export-credentials:*)",
      "Bash(aws configure get:*)",
      "Bash(aws sts assume-role:*)",
      "Bash(aws sts get-session-token:*)",
      "Bash(aws iam create-access-key:*)",
      "Bash(aws kms schedule-key-deletion:*)",
      "Bash(cdk destroy:*)",
      "Bash(terraform destroy:*)",
      "Bash(pulumi destroy:*)",
      "Bash(kubectl delete namespace:*)",
      "Edit(*/.aws/*)",
      "Edit(*/.ssh/*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "codex@openai-codex": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "askUserQuestionTimeout": "10m",
  "dialogExpiry": "10m",
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "timeFormat": "12-hour",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "verbose": true,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults"
    ],
    "soft_deny": [
      "$defaults"
    ],
    "hard_deny": [
      "$defaults",
      "Never run commands that unregister, terminate-and-remove, reset, reinstall, or delete the virtual disk/rootfs of a WSL2 distribution (e.g. `wsl --unregister`, deleting ext4.vhdx or similar WSL disk images)",
      "Never modify Windows system state from within WSL or via powershell.exe/cmd.exe/reg.exe/PowerShell cmdlets — this includes editing the Windows registry, Windows boot configuration (bcdedit), installed Windows features/programs/drivers, Windows user accounts, or files under /mnt/c/Windows or C:\\Windows",
      "Never partition, format, wipe, or write raw disk images to the Windows system drive or any WSL virtual disk (e.g. via dd, diskpart, Format-Volume, Clear-Disk) outside this project's own working directory",
      "Never edit WSL2/Windows-level configuration that controls distro or boot behavior (e.g. /etc/wsl.conf, %UserProfile%\\.wslconfig, C:\\Windows\\System32\\drivers\\etc\\hosts, WSL/Windows Terminal registry keys, Windows feature toggles for WSL/Hyper-V/Virtual Machine Platform) without the user naming that specific change first"
    ],
    "environment": [
      "$defaults"
    ]
  },
  "skipWorkflowUsageWarning": true
}
